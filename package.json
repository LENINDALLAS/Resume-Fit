{
  "name": "resume-fit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontendDashboard",
    "frontendExtension"
  ],
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "dev:backend": "node init && npm run dev --workspace=backend",
    "dev:dashboard": "node init && npm run dev --workspace=frontendDashboard",
    "dev:extension": "node init && npm run dev --workspace=frontendExtension",
    "build": "node init && npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=frontendDashboard && npm run build --workspace=frontendExtension",
    "test:backend": "npm run test --workspace=backend",
    "icons": "node scripts/generateIcons.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
