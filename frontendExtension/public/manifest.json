{
  "manifest_version": 3,
  "name": "Resume-Fit",
  "version": "1.0.0",
  "description": "Analyze how well your resume matches a job description, right from your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage", "tabs"]
}
